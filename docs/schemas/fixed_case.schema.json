{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed interpretability case",
  "type": "object",
  "required": ["case_uid", "test_index", "image_paths", "image_sha256", "selection_seed", "selection_stratum"],
  "properties": {
    "case_uid": {"type": "string"},
    "test_index": {"type": "integer", "minimum": 0},
    "image_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "image_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "selection_seed": {"type": "integer"},
    "selection_stratum": {"type": "string"},
    "target_span_id": {"type": "string"}
  }
}
